<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_950">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="42dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="28dp"
            android:paddingEnd="26dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_card"
                android:elevation="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="15dp"
                android:paddingEnd="22dp"
                android:paddingBottom="16dp">

                <View
                    android:layout_width="38dp"
                    android:layout_height="4dp"
                    android:background="#56585D" />

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginTop="20dp"
                    android:contentDescription="LUCKY HUB icon"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_launcher_luckyhub" />

                <TextView
                    android:id="@+id/loginTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:gravity="center"
                    android:text="LUCKY HUB 8BP LOADER"
                    android:textColor="@color/login_ink"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="0.18"
                    android:text="PREMIUM LOADER"
                    android:textColor="#22AFC5"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="start"
                    android:text="ACCESS KEY"
                    android:textColor="#72757C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="15dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="⌑"
                        android:textColor="#555961"
                        android:textSize="22sp" />

                    <EditText
                        android:id="@+id/accessKey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Enter Your (Key Here)"
                        android:inputType="textVisiblePassword|textNoSuggestions"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/login_ink"
                        android:textColorHint="#858890"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/pasteButton"
                        android:layout_width="54dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_login_card"
                        android:clickable="true"
                        android:contentDescription="Paste license key"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="PASTE"
                        android:textColor="#22AFC5"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/loginStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:minHeight="18dp"
                    android:text=""
                    android:textColor="#9B3A47"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/loginProgress"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/signal_blue"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/loginButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_login_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="ACTIVATE"
                    android:textColor="#F4F4F5"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/getKeyButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="GET OR RENEW A KEY"
                    android:textColor="#178EA3"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:letterSpacing="0.14"
                    android:text="• SECURE END-TO-END SESSION •"
                    android:textColor="#666A72"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/loginWatermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_watermark"
        android:clickable="false"
        android:focusable="false"
        android:longClickable="false"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/developer_watermark"
        android:textColor="#C3CCD6"
        android:textSize="9sp"
        android:textStyle="bold" />
</FrameLayout>
